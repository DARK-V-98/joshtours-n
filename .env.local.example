NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Google Reviews (server-only — DO NOT prefix with NEXT_PUBLIC_) ────────────
# Get your Place ID from: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-google-place-id

# ── Vercel Cron Job secret (set this in Vercel dashboard → Settings → Env Vars)
# Vercel sets CRON_SECRET automatically on Pro; on Hobby set it manually.
CRON_SECRET=a-long-random-secret-string

# ── Admin manual refresh (safe to expose — it's just the same secret as hint)
NEXT_PUBLIC_CRON_SECRET_HINT=a-long-random-secret-string
